<!DOCTYPE html>
<html>
<head>
    <title>Mental Math</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            padding: 30px 15px;
        }

        h1 {
            font-size: 32px;
        }

        .problem {
            font-size: 40px;
            margin: 30px 0;
        }

        button {
            font-size: 20px;
            padding: 14px 24px;
            margin: 10px;
            cursor: pointer;
        }
    </style>
</head>

<body>
    <h1>Mental Math</h1>

    <div id="homeScreen">
        <button onclick="startPractice()">2 by 2</button>
    </div>

    <div id="practiceScreen" hidden>
        <div class="problem" id="problem"></div>
        <button onclick="showAnswer()">Show Answer</button>
    </div>

    <div id="answerScreen" hidden>
        <div class="problem" id="answer"></div>
        <button onclick="goHome()">Home</button>
    </div>

    <script>
        let number1;
        let number2;

        function startPractice() {
            number1 = Math.floor(Math.random() * 90) + 10;
            number2 = Math.floor(Math.random() * 90) + 10;

            document.getElementById("problem").textContent =
                number1 + " × " + number2;

            document.getElementById("homeScreen").hidden = true;
            document.getElementById("practiceScreen").hidden = false;
        }

        function showAnswer() {
            document.getElementById("answer").textContent =
                number1 + " × " + number2 + " = " + (number1 * number2);

            document.getElementById("practiceScreen").hidden = true;
            document.getElementById("answerScreen").hidden = false;
        }

        function goHome() {
            document.getElementById("answerScreen").hidden = true;
            document.getElementById("homeScreen").hidden = false;
        }
    </script>
</body>
</html>
